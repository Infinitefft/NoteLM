# 复制为 `.env` 后填写本地值；勿将 `.env` 提交到 Git。

# PostgreSQL（请先创建库: CREATE DATABASE notelm;）
# 账号/密码/host 按你本机填写
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/notelm?schema=public"

# Chroma HTTP API（与仓库根目录 docker-compose.yml 中端口一致）
CHROMA_URL="http://localhost:8000"

# RAG 原始文件落盘根目录（相对 back/ 或绝对路径均可，由实现侧解析）
RAG_STORAGE_ROOT="./data/rag/uploads"
